{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/where.py\" --brief 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/where.py\" --brief 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/where.py\" --brief",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/context_guard.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/context_guard.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/context_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/recall_hook.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/recall_hook.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/recall_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
